# Django uses SQLite-only (db.sqlite3 by default) without DATABASE_URL.
# On a persistent host, set SQLITE_DATABASE_PATH to an absolute filename.
# SQLITE_DATABASE_PATH=/var/lib/cubixgear/db.sqlite3
# Never deploy SQLite as live writable data on Vercel Functions.
# DJANGO_ALLOWED_HOSTS=api.yourdomain.com
# CORS_ALLOWED_ORIGINS=https://app.yourdomain.com
# CSRF_TRUSTED_ORIGINS=https://app.yourdomain.com
# SECURE_SSL_REDIRECT=True
# SECURE_HSTS_SECONDS=3600
# Never put database credentials in VITE_* values or commit a real .env file.

DJANGO_SECRET_KEY=change-this-in-production-use-at-least-32-random-bytes
JWT_SIGNING_KEY=change-this-jwt-signing-key-use-at-least-32-random-bytes
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_TIME_ZONE=Asia/Kolkata

# PostgreSQL production example:
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CORS_ALLOW_CREDENTIALS=False
FRONTEND_URL=http://localhost:5173

JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=7
MAGIC_LINK_EXPIRY_MINUTES=15

# Local: setup emails are printed in the Django terminal.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_TIMEOUT=15
DEFAULT_FROM_EMAIL=CubixGear <no-reply@cubixgear.com>

# Production SMTP example:
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=your-business-email@example.com
# EMAIL_HOST_PASSWORD=your-app-password
# EMAIL_USE_TLS=True
# DEFAULT_FROM_EMAIL=CubixGear <your-business-email@example.com>


# First company/admin bootstrap (local setup only)
BOOTSTRAP_COMPANY_NAME=CubixGear Motors
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-password


# Celery / Redis is disabled for WSGI-only hosting.
# Keep these reference values commented until installing a worker + Redis.
# CELERY_BROKER_URL=redis://127.0.0.1:6379/0
# CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/1
# CELERY_TASK_TIME_LIMIT=120
# CELERY_TASK_SOFT_TIME_LIMIT=90
# CELERY_TASK_ALWAYS_EAGER=False
# CELERY_TASK_EAGER_PROPAGATES=True

# Production HTTPS settings (use a correctly configured HTTPS proxy)
# SECURE_SSL_REDIRECT=True
# SECURE_HSTS_SECONDS=3600
# CSRF_TRUSTED_ORIGINS=https://backend.example.com
# Email is synchronous; no Celery worker is needed for email.
# Attendance auto-close scheduled tasks are paused until Celery is re-enabled.
