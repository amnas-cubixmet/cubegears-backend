# Django uses SQLite-only (db.sqlite3 by default) without DATABASE_URL.
# On a persistent host, set SQLITE_DATABASE_PATH to an absolute filename.
# SQLITE_DATABASE_PATH=/var/lib/cubixgear/db.sqlite3
# Never deploy SQLite as live writable data on Vercel Functions.
# DJANGO_ALLOWED_HOSTS=api.yourdomain.com
# CORS_ALLOWED_ORIGINS=https://app.yourdomain.com
# CSRF_TRUSTED_ORIGINS=https://app.yourdomain.com
# SECURE_SSL_REDIRECT=True
# SECURE_HSTS_SECONDS=3600
# Never put database credentials in VITE_* values or commit a real .env file.

DJANGO_SECRET_KEY=change-this-in-production-use-at-least-32-random-bytes
JWT_SIGNING_KEY=change-this-jwt-signing-key-use-at-least-32-random-bytes
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_TIME_ZONE=Asia/Kolkata

# SQLite uses a persistent server volume in production (never Vercel Functions).
# SQLITE_DATABASE_PATH=/var/lib/cubixgear/db.sqlite3
# DJANGO_MEDIA_ROOT=/var/lib/cubixgear/media  # Persistent public company logos

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CORS_ALLOW_CREDENTIALS=False
FRONTEND_URL=http://localhost:5173

JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=7
MAGIC_LINK_EXPIRY_MINUTES=15
PASSWORD_RESET_TIMEOUT_SECONDS=3600

# Production: configure an HTTPS reverse proxy and trusted admin/public URLs.
# DJANGO_ALLOWED_HOSTS=api.yourdomain.com
# FRONTEND_URL=https://app.yourdomain.com
# CORS_ALLOWED_ORIGINS=https://app.yourdomain.com
# CSRF_TRUSTED_ORIGINS=https://api.yourdomain.com
# SECURE_SSL_REDIRECT=True
# SECURE_HSTS_SECONDS=31536000
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True


# Console mode: emails are printed by the Celery worker, never delivered to an inbox.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_TIMEOUT=15
DEFAULT_FROM_EMAIL=CubixGear <no-reply@cubixgear.com>

# Production SMTP example:
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=your-business-email@example.com
# EMAIL_HOST_PASSWORD=your-app-password
# EMAIL_USE_TLS=True
# EMAIL_USE_SSL=False
# DEFAULT_FROM_EMAIL=CubixGear <your-business-email@example.com>


# First company/admin bootstrap (local setup only)
BOOTSTRAP_COMPANY_NAME=CubixGear Motors
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-password


# All account emails are Celery-only; without Redis/worker they never send.
# Configure Redis and worker before enabling, especially for password setup/reset.
# For real inbox delivery also select the SMTP backend and fill its credentials.
# Start with: python manage.py start_email_worker
# disabled (default) / smtp (PythonAnywhere with verified provider) / celery (Redis worker)
ACCOUNT_EMAIL_DELIVERY_MODE=disabled
EMAIL_CELERY_ENABLED=False
# CELERY_BROKER_URL=redis://127.0.0.1:6379/0
# Celery / Redis billing schedules are disabled for WSGI-only hosting.
# Keep these reference values commented until installing a worker + Redis.
# CELERY_BROKER_URL=redis://127.0.0.1:6379/0
# CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/1
# CELERY_TASK_TIME_LIMIT=120
# CELERY_TASK_SOFT_TIME_LIMIT=90
# CELERY_TASK_ALWAYS_EAGER=False
# CELERY_TASK_EAGER_PROPAGATES=True

# Production HTTPS settings (use a correctly configured HTTPS proxy)
# SECURE_SSL_REDIRECT=True
# SECURE_HSTS_SECONDS=3600
# CSRF_TRUSTED_ORIGINS=https://backend.example.com
# Email requires Redis and a running Celery worker; Beat is not required.
# Run attendance manually via scheduled management command OR Celery Beat, not both.
ATTENDANCE_AUTO_CHECKOUT_ENABLED=False
# For SMTP-only hosting leave Celery/Billing flags disabled.
# Do not enable live billing until database and tenant entitlement QA passes.

# Razorpay SaaS subscriptions — use test credentials until staging passes.
# Keys are private Django server env settings; NEVER expose KEY_SECRET to Vite.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Turn on ONLY after merchant account/webhook/legacy account migration review.
SAAS_PAYMENT_ENFORCEMENT_ENABLED=False

# Paid feature gating is deliberately OFF until catalog and existing-company
# entitlements have been reviewed. Read docs/feature-label-activation-setup.md.
# After safe staging validation, change the deployment's real environment to:
# CREDIT_FEATURE_ENFORCEMENT_ENABLED=True
# CREDIT_STRICT_MODULE_GATING_ENABLED=True
# Never turn this on for existing production companies without backfilling
# their previously available features and communicating any changes.
CREDIT_FEATURE_ENFORCEMENT_ENABLED=False
CREDIT_STRICT_MODULE_GATING_ENABLED=False

# OPTIONAL: Only active purchased Feature Labels grant workshop modules.
# Use true on staging/local only AFTER migrating existing tenant entitlements.
# Requires CREDIT_FEATURE_ENFORCEMENT_ENABLED=True to buy/activate labels.
# If label-only is true while enforcement is false, paid modules fail closed.
CREDIT_LABEL_ONLY_ACCESS_ENABLED=False
