# ==========================================
# CUBEGEARS — PYTHONANYWHERE PRODUCTION
# ==========================================

# DJANGO SECURITY
# Preserve existing generated DJANGO_SECRET_KEY
# Preserve existing generated JWT_SIGNING_KEY
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=cardflow.pythonanywhere.com
DJANGO_TIME_ZONE=Asia/Kolkata

SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=3600
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True

# SQLITE DATABASE
SQLITE_DATABASE_PATH=/home/cardflow/cubegears-backend/db.sqlite3

# FILE STORAGE
DJANGO_MEDIA_ROOT=/home/cardflow/cubegears-backend/media
PRIVATE_JOB_MEDIA_ROOT=/home/cardflow/private_job_media

# FRONTEND
# Replace with your actual deployed HTTPS URL
FRONTEND_URL=https://YOUR-FRONTEND.example
CORS_ALLOWED_ORIGINS=https://YOUR-FRONTEND.example
CORS_ALLOW_CREDENTIALS=False
CSRF_TRUSTED_ORIGINS=https://cardflow.pythonanywhere.com

# AUTHENTICATION
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=7
MAGIC_LINK_EXPIRY_MINUTES=15
PASSWORD_RESET_TIMEOUT_SECONDS=3600

# EMAIL
# Enable smtp only after configuring real credentials
ACCOUNT_EMAIL_DELIVERY_MODE=disabled
EMAIL_CELERY_ENABLED=False

EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_TIMEOUT=15
DEFAULT_FROM_EMAIL=

# CELERY - UNSUPPORTED ON PYTHONANYWHERE
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=
CELERY_TASK_ALWAYS_EAGER=False

# AUTOMATION
ATTENDANCE_AUTO_CHECKOUT_ENABLED=False
CREDIT_BILLING_CELERY_ENABLED=False
BILLING_EMAIL_ALERTS_ENABLED=False

# RAZORPAY
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# TENANT
TENANT_BASE_DOMAIN=

# FEATURE ACCESS
CREDIT_FEATURE_ENFORCEMENT_ENABLED=False
CREDIT_LABEL_ONLY_ACCESS_ENABLED=False
CREDIT_STRICT_MODULE_GATING_ENABLED=False
CREDIT_FEATURE_STRICT_GATE_ENABLED=False

# BILLING
CREDIT_POSTPAID_FEATURE_BILLING_ENABLED=False
CREDIT_FEATURE_POSTPAID_MONTHLY_ENABLED=False
STORAGE_MONTHLY_METERED_ENABLED=False
STORAGE_METER_INTERVAL_SECONDS=300