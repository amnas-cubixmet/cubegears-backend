# CubeGears BACKEND — LOCAL DEVELOPMENT EXAMPLE ONLY (no real credentials).
# Windows: Copy-Item .env.example .env
# Linux:   cp .env.example .env
# Do not upload .env or commit any actual credentials.

DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_TIME_ZONE=Asia/Kolkata
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False

# Standard local PostgreSQL connection — the only supported backend DB env format.
# Set DB_PASSWORD privately in .env, never in committed templates.
# Database and user must exist locally before running migrations.
DB_ENGINE=django.db.backends.postgresql
DB_NAME=cubixgear_db
DB_USER=cubixgear_user
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432
DB_CONN_MAX_AGE=0

FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173
CUSTOMER_PORTAL_BASE_URL=http://localhost:5174/access

# Local email is printed in console. Do not paste SMTP app passwords here.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
ACCOUNT_EMAIL_DELIVERY_MODE=disabled
EMAIL_CELERY_ENABLED=False

# Start Redis + Django + worker as separate terminals when testing Celery.
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/1
CELERY_TASK_ALWAYS_EAGER=False
CREDIT_BILLING_CELERY_ENABLED=False
ATTENDANCE_AUTO_CHECKOUT_ENABLED=False
BILLING_EMAIL_ALERTS_ENABLED=False
WHATSAPP_SEND_ENABLED=False
